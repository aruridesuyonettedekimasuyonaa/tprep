  "questions": [
    {
      "questionId": "math-1-r1-q1-1",
      "reportNo": 1,
      "majorNo": 1,
      "minorNo": "(1)",
      "sortOrder": 1,
      "questionText": "次の二次式を因数分解せよ：\nx² - 5x + 6",
      "answerText": "(x - 2)(x - 3)"
    },
    {
      "questionId": "math-1-r1-q1-2",
      "reportNo": 1,
      "majorNo": 1,
      "minorNo": "(2)",
      "sortOrder": 2,
      "questionText": "次の二次式を因数分解せよ：\nx² + 7x + 12",
      "answerText": "(x + 3)(x + 4)"
    },
    {
      "questionId": "math-1-r1-q1-3",
      "reportNo": 1,
      "majorNo": 1,
      "minorNo": "(3)",
      "sortOrder": 3,
      "questionText": "次の二次式を因数分解せよ：\n2x² - 7x + 3",
      "answerText": "(2x - 1)(x - 3)"
    },
    {
      "questionId": "math-1-r1-q2-1",
      "reportNo": 1,
      "majorNo": 2,
      "minorNo": "(1)",
      "sortOrder": 4,
      "questionText": "方程式 x² - 4 = 0 の解を求めよ。",
      "answerText": "x = ±2"
    },
    {
      "questionId": "math-1-r1-q2-2",
      "reportNo": 1,
      "majorNo": 2,
      "minorNo": "(2)",
      "sortOrder": 5,
      "questionText": "方程式 x² - 3x + 2 = 0 の解を求めよ。",
      "answerText": "x = 1, 2"
    },
    {
      "questionId": "math-1-r1-q3-1",
      "reportNo": 1,
      "majorNo": 3,
      "minorNo": "(1)",
      "sortOrder": 6,
      "questionText": "二次関数 y = x² - 4x + 3 の頂点の座標を求めよ。",
      "answerText": "頂点：(2, -1)"
    },
    {
      "questionId": "math-1-r1-q3-2",
      "reportNo": 1,
      "majorNo": 3,
      "minorNo": "(2)",
      "sortOrder": 7,
      "questionText": "二次関数 y = -x² + 2x + 3 のグラフは上に凸か、下に凸か答えよ。\nまた、軸の方程式を求めよ。",
      "answerText": "上に凸（a = -1 < 0 のため）\n軸：x = 1"
    },
    {
      "questionId": "math-1-r2-q1-1",
      "reportNo": 2,
      "majorNo": 1,
      "minorNo": "(1)",
      "sortOrder": 1,
      "questionText": "次の集合 A, B に対して、和集合 A∪B を求めよ。\nA = {1, 2, 3, 4}, B = {3, 4, 5, 6}",
      "answerText": "A∪B = {1, 2, 3, 4, 5, 6}"
    },
    {
      "questionId": "math-1-r2-q1-2",
      "reportNo": 2,
      "majorNo": 1,
      "minorNo": "(2)",
      "sortOrder": 2,
      "questionText": "次の集合 A, B に対して、積集合 A∩B を求めよ。\nA = {1, 2, 3, 4}, B = {3, 4, 5, 6}",
      "answerText": "A∩B = {3, 4}"
    },
    {
      "questionId": "math-1-r2-q2-1",
      "reportNo": 2,
      "majorNo": 2,
      "minorNo": "1",
      "sortOrder": 3,
      "questionText": "命題「x > 2 ならば x > 0」の逆・裏・対偶を述べよ。",
      "answerText": "逆：x > 0 ならば x > 2\n裏：x ≦ 2 ならば x ≦ 0\n対偶：x ≦ 0 ならば x ≦ 2"
    }
  ]
}
